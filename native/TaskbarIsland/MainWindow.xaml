<Window x:Class="TaskbarIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarIsland" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Width" Height="44" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{StaticResource TextFont}" FontSize="12" Foreground="White">

  <!-- 1/255 alpha so the whole strip is clickable (fully transparent pixels click through) -->
  <StackPanel x:Name="Root" Orientation="Horizontal" Height="44" Background="#01000000">

    <!-- ===================== island =====================
         Modes: Closed (Spotify not open: just a round button), Compact (paused a while: cover + dots),
         Normal (cover + title + equalizer). Widths spring between modes. -->
    <Border x:Name="Island" Height="40" CornerRadius="20" Margin="0,0,6,0" Padding="5,0,12,0"
            BorderBrush="#17FFFFFF" BorderThickness="1" VerticalAlignment="Center">
      <Border.Background><SolidColorBrush x:Name="IslandBg" Color="#0E0E0E"/></Border.Background>
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- cover (or a music note when Spotify is closed) -->
          <Grid x:Name="Art" Width="30" Height="30" Cursor="Arrow">
            <Ellipse x:Name="ArtCircle" Fill="#222222"/>
            <TextBlock x:Name="ArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="14"
                       Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Stroke="#24FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
          </Grid>

          <!-- title - artist; the wrapper's width animates to 0 in Compact/Closed -->
          <Border x:Name="TextWrap" Width="0" ClipToBounds="True">
            <Canvas x:Name="TextHost" Width="180" Height="20" Margin="10,0,0,0" ClipToBounds="True" HorizontalAlignment="Left">
              <StackPanel x:Name="Track" Orientation="Horizontal" Canvas.Left="2" Canvas.Top="0" TextElement.FontSize="13.5" TextElement.FontFamily="{StaticResource SpotifyFont}" TextOptions.TextFormattingMode="Ideal">
                <StackPanel.RenderTransform><TranslateTransform x:Name="TrackShift"/></StackPanel.RenderTransform>
                <TextBlock x:Name="T1" VerticalAlignment="Center"/>
                <TextBlock x:Name="T2" VerticalAlignment="Center" Margin="32,0,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Canvas>
          </Border>

          <!-- equalizer; the wrapper's width animates to 0 in Closed -->
          <Border x:Name="SlotWrap" Width="0" ClipToBounds="True">
            <StackPanel x:Name="Eq" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="19" Margin="10,0,0,0">
              <Rectangle x:Name="Eq1" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Margin="0,0,2.5,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
              <Rectangle x:Name="Eq2" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Margin="0,0,2.5,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
              <Rectangle x:Name="Eq3" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Margin="0,0,2.5,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
              <Rectangle x:Name="Eq4" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- progress hairline (Normal mode only) -->
        <Border x:Name="ProgressTrack" Height="1.5" VerticalAlignment="Bottom" Margin="40,0,5,2"
                Background="#14FFFFFF" CornerRadius="1" IsHitTestVisible="False" Opacity="0">
          <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="1" Opacity="0.85"/>
        </Border>
      </Grid>
    </Border>

    <!-- ===================== batteries ===================== -->
    <StackPanel x:Name="Batteries" Orientation="Horizontal" Height="44"/>
  </StackPanel>
</Window>
