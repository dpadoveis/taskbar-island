<Window x:Class="TaskbarIsland.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarIslandCard" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{StaticResource TextFont}" Foreground="White">

  <!-- 1/255 alpha margin keeps the scale-in animation from being clipped and the card hoverable -->
  <Grid Background="#01000000">
    <Border x:Name="Card" Width="312" Margin="10" Padding="14,14,14,10" CornerRadius="18"
            BorderBrush="#1CFFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop x:Name="TintStop" Color="#0E0E0E" Offset="0"/>
          <GradientStop Color="#0A0A0A" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
          <TranslateTransform x:Name="CardShift"/>
        </TransformGroup>
      </Border.RenderTransform>

      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="Cover" Width="64" Height="64" CornerRadius="12" Background="#222222" Cursor="Hand">
            <Border BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
            <TextBlock x:Name="Title" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="Sub" FontSize="12.5" Foreground="#99FFFFFF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel x:Name="Eq" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="19">
            <Rectangle x:Name="Eq1" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Margin="0,0,2.5,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
            <Rectangle x:Name="Eq2" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Margin="0,0,2.5,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
            <Rectangle x:Name="Eq3" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Margin="0,0,2.5,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
            <Rectangle x:Name="Eq4" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
          </StackPanel>
        </Grid>

        <Grid x:Name="ProgressTrack" Height="4" Margin="0,14,0,5">
          <Border Background="#1FFFFFFF" CornerRadius="2"/>
          <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="2"/>
        </Grid>
        <Grid>
          <TextBlock x:Name="Elapsed" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Left"/>
          <TextBlock x:Name="Remaining" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Right"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
          <Button Style="{StaticResource CardButton}" x:Name="PrevButton" Tag="prev" Click="OnControl">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M3.6,3.2 C4.1,3.2 4.5,3.6 4.5,4.1 L4.5,11.9 C4.5,12.4 4.1,12.8 3.6,12.8 C3.1,12.8 2.7,12.4 2.7,11.9 L2.7,4.1 C2.7,3.6 3.1,3.2 3.6,3.2 Z M12.7,3.8 L12.7,12.2 C12.7,12.9 11.9,13.3 11.3,12.9 L5.7,8.7 C5.2,8.3 5.2,7.7 5.7,7.3 L11.3,3.1 C11.9,2.7 12.7,3.1 12.7,3.8 Z"/>
          </Button>
          <Button Style="{StaticResource CardButton}" x:Name="ToggleButton" Tag="toggle" Click="OnControl" Margin="14,0">
            <Path x:Name="PlayPause" Width="22" Height="22" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button Style="{StaticResource CardButton}" x:Name="NextButton" Tag="next" Click="OnControl">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M12.4,3.2 C11.9,3.2 11.5,3.6 11.5,4.1 L11.5,11.9 C11.5,12.4 11.9,12.8 12.4,12.8 C12.9,12.8 13.3,12.4 13.3,11.9 L13.3,4.1 C13.3,3.6 12.9,3.2 12.4,3.2 Z M3.3,3.8 L3.3,12.2 C3.3,12.9 4.1,13.3 4.7,12.9 L10.3,8.7 C10.8,8.3 10.8,7.7 10.3,7.3 L4.7,3.1 C4.1,2.7 3.3,3.1 3.3,3.8 Z"/>
          </Button>
        </StackPanel>

        <!-- settings footer: game-mode switch + colour swatches -->
        <Border Height="1" Background="#14FFFFFF" Margin="0,8,0,8"/>
        <Grid>
          <StackPanel x:Name="GameRow" Orientation="Horizontal" VerticalAlignment="Center" Background="#01000000" Cursor="Hand">
            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
            <TextBlock x:Name="GameLabel" FontSize="12" Foreground="#B3FFFFFF" Margin="6,0,8,0" VerticalAlignment="Center"/>
            <Border x:Name="Switch" Width="30" Height="16" CornerRadius="8" Background="#33FFFFFF" VerticalAlignment="Center">
              <Ellipse Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="KnobShift"/></Ellipse.RenderTransform>
              </Ellipse>
            </Border>
          </StackPanel>
          <StackPanel x:Name="Swatches" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
