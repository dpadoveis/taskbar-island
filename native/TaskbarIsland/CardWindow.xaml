<Window x:Class="TaskbarIsland.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarIslandCard" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Width" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{StaticResource TextFont}" Foreground="White">

  <!-- fully transparent around the card: those pixels click through. The window is sized for the open settings,
       the card sits at the bottom, so opening the settings never resizes the window (smooth animation). -->
  <Grid>
    <Border x:Name="Card" Width="320" Margin="10" VerticalAlignment="Bottom" Padding="18,18,18,12" CornerRadius="18"
            BorderBrush="#1CFFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop x:Name="TintStop" Color="#0E0E0E" Offset="0"/>
          <GradientStop Color="#0A0A0A" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
          <TranslateTransform x:Name="CardShift"/>
        </TransformGroup>
      </Border.RenderTransform>

      <Grid>
      <StackPanel>
        <!-- settings: hidden until the gear is clicked; height springs open, card grows upwards -->
        <Border x:Name="SettingsPanel" Height="0" Opacity="0" ClipToBounds="True">
          <StackPanel x:Name="SettingsContent" Margin="0,22,0,0">
            <Grid x:Name="GameRow" Background="#01000000" Cursor="Hand">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" Width="18"/>
                <TextBlock x:Name="GameLabel" FontSize="12.5" Foreground="#E6FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <Border x:Name="Switch" Width="30" Height="16" CornerRadius="8" Background="#33FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="KnobShift"/></Ellipse.RenderTransform>
                </Ellipse>
              </Border>
            </Grid>
            <Grid Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" Width="18"/>
                <TextBlock x:Name="ColorLabel" FontSize="12.5" Foreground="#E6FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel x:Name="Swatches" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-3,0"/>
            </Grid>
            <Border Height="1" Background="#14FFFFFF" Margin="0,16,0,16"/>
          </StackPanel>
        </Border>

        <!-- header: cover, title / artist, equalizer -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="Cover" Width="72" Height="72" CornerRadius="12" Background="#222222" Cursor="Hand">
            <Border BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
            <TextBlock x:Name="Title" FontSize="16.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource SpotifyFont}"/>
            <TextBlock x:Name="Sub" FontSize="13" Foreground="#A6FFFFFF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource SpotifyFont}"/>
          </StackPanel>
          <StackPanel x:Name="Eq" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="19" Margin="0,0,2,0">
            <Rectangle x:Name="Eq1" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Margin="0,0,2.5,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
            <Rectangle x:Name="Eq2" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Margin="0,0,2.5,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
            <Rectangle x:Name="Eq3" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Margin="0,0,2.5,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
            <Rectangle x:Name="Eq4" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.28"/></Rectangle.RenderTransform></Rectangle>
          </StackPanel>
        </Grid>

        <!-- seek bar: 16px tall hit area around a 4px track; click or drag to jump; knob shows on hover -->
        <Grid x:Name="SeekArea" Height="16" Margin="0,16,0,0" Background="#01000000" Cursor="Hand">
          <Grid x:Name="ProgressTrack" Height="4" VerticalAlignment="Center">
            <Border Background="#1FFFFFFF" CornerRadius="2"/>
            <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="2"/>
          </Grid>
          <Ellipse x:Name="SeekKnob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <Grid Margin="0,2,0,0">
          <TextBlock x:Name="Elapsed" FontSize="11.5" Foreground="#8CFFFFFF" HorizontalAlignment="Left" FontFamily="{StaticResource SpotifyFont}"/>
          <TextBlock x:Name="Remaining" FontSize="11.5" Foreground="#8CFFFFFF" HorizontalAlignment="Right" FontFamily="{StaticResource SpotifyFont}"/>
        </Grid>

        <!-- controls, one icon family (rounded strokes / soft fills), play in a white circle like Spotify -->
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" Style="{StaticResource CardButton}" x:Name="ShuffleButton" Tag="shuffle" Click="OnControl">
            <Grid Width="18" Height="18">
              <Path Stretch="None" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M1.5,4.5 L4.2,4.5 C5.8,4.5 6.8,5.3 7.7,6.6 L10.3,10.4 C11.2,11.7 12.2,12.5 13.8,12.5 L16,12.5 M1.5,12.5 L4.2,12.5 C5.8,12.5 6.8,11.7 7.7,10.4 M10.3,6.6 C11.2,5.3 12.2,4.5 13.8,4.5 L16,4.5 M13.9,2.4 L16,4.5 L13.9,6.6 M13.9,10.4 L16,12.5 L13.9,14.6"/>
              <Ellipse x:Name="ShuffleDot" Width="4" Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-8" Visibility="Hidden"/>
            </Grid>
          </Button>

          <Button Grid.Column="1" Style="{StaticResource CardButton}" x:Name="PrevButton" Tag="prev" Click="OnControl">
            <Path Width="17" Height="17" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M3.6,3.2 C4.1,3.2 4.5,3.6 4.5,4.1 L4.5,11.9 C4.5,12.4 4.1,12.8 3.6,12.8 C3.1,12.8 2.7,12.4 2.7,11.9 L2.7,4.1 C2.7,3.6 3.1,3.2 3.6,3.2 Z M12.7,3.8 L12.7,12.2 C12.7,12.9 11.9,13.3 11.3,12.9 L5.7,8.7 C5.2,8.3 5.2,7.7 5.7,7.3 L11.3,3.1 C11.9,2.7 12.7,3.1 12.7,3.8 Z"/>
          </Button>

          <Button Grid.Column="2" Style="{StaticResource PlayButton}" x:Name="ToggleButton" Tag="toggle" Click="OnControl" Margin="8,0">
            <Path x:Name="PlayPause" Width="15" Height="15" Stretch="Uniform" Fill="#0B0B0B"/>
          </Button>

          <Button Grid.Column="3" Style="{StaticResource CardButton}" x:Name="NextButton" Tag="next" Click="OnControl">
            <Path Width="17" Height="17" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M12.4,3.2 C11.9,3.2 11.5,3.6 11.5,4.1 L11.5,11.9 C11.5,12.4 11.9,12.8 12.4,12.8 C12.9,12.8 13.3,12.4 13.3,11.9 L13.3,4.1 C13.3,3.6 12.9,3.2 12.4,3.2 Z M3.3,3.8 L3.3,12.2 C3.3,12.9 4.1,13.3 4.7,12.9 L10.3,8.7 C10.8,8.3 10.8,7.7 10.3,7.3 L4.7,3.1 C4.1,2.7 3.3,3.1 3.3,3.8 Z"/>
          </Button>

          <Button Grid.Column="4" Style="{StaticResource CardButton}" x:Name="RepeatButton" Tag="repeat" Click="OnControl">
            <Grid Width="18" Height="18">
              <Path Stretch="None" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M2.5,8.5 L2.5,7 C2.5,5.3 3.8,4 5.5,4 L14.5,4 M12.4,1.9 L14.5,4 L12.4,6.1 M15.5,9.5 L15.5,11 C15.5,12.7 14.2,14 12.5,14 L3.5,14 M5.6,11.9 L3.5,14 L5.6,16.1"/>
              <TextBlock x:Name="RepeatOne" Text="1" FontSize="8" FontWeight="Bold" FontFamily="{StaticResource SpotifyFont}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="0,0,0,1" Visibility="Collapsed" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <Ellipse x:Name="RepeatDot" Width="4" Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-8" Visibility="Hidden"/>
            </Grid>
          </Button>
        </Grid>
      </StackPanel>

      <!-- gear (top-right corner): shows / hides the settings -->
      <Button x:Name="GearButton" Style="{StaticResource CtlButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,-12,-12,0" Click="OnGear">
        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" RenderTransformOrigin="0.5,0.5"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
          <TextBlock.RenderTransform><RotateTransform x:Name="GearSpin"/></TextBlock.RenderTransform>
        </TextBlock>
      </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
